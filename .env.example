# AlertContacts — exemple de configuration
# Copier ce fichier en .env et remplir les valeurs

BASE_URL=https://mobile.alertcontacts.net
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
GOOGLE_PLACES_API_KEY=your_google_places_key_here
# Clé publique Android RevenueCat (jamais une clé secrète).
#REVENUECAT_ANDROID_API_KEY=test_sAFltNdmrNVqKMAloexSpIpZFrY
REVENUECAT_ANDROID_API_KEY=goog_PHkUMVTwgCAOxWLpqzVpWafoYPa
# Doit correspondre à l'identifier de l'entitlement RevenueCat.
# Pour la production, utilisez généralement : premium
REVENUECAT_ENTITLEMENT_ID=AlertContacts Pro

# PostHog — clé projet publique, laisser vide pour désactiver l'analytics produit.
POSTHOG_PROJECT_API_KEY=phc_waum6H6WDLCuRQnXgQ4HT7RFJvZBSsYtXL75ErU5vdym
POSTHOG_HOST=https://us.i.posthog.com
